{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "合作全生命周期：并行尽调、补贴占用、阶段验收、指标变化、持续使用、失败退出与证据归属",
  "type": "object",
  "required": ["domain", "version", "engagements"],
  "properties": {
    "domain": { "const": "sme-digital-matching" },
    "version": { "type": "integer", "minimum": 1 },
    "engagements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "engagement_id",
          "enterprise_id",
          "product_id",
          "provider_id",
          "match_id",
          "started_at",
          "state",
          "data_isolation",
          "evidence_ownership",
          "records"
        ],
        "properties": {
          "engagement_id": { "type": "string", "minLength": 1 },
          "enterprise_id": { "type": "string", "minLength": 1 },
          "product_id": { "type": "string", "minLength": 1 },
          "provider_id": { "type": "string", "minLength": 1 },
          "match_id": { "type": "string", "minLength": 1 },
          "started_at": { "type": "string", "format": "date" },
          "state": {
            "enum": [
              "due_diligence",
              "contracted",
              "deployed",
              "stage_accepted",
              "in_use",
              "exited_failed",
              "exited_completed"
            ]
          },
          "subsidy": {
            "type": "object",
            "required": ["program_id", "reserved_amount", "currency", "reserved_at", "occupancy"],
            "properties": {
              "program_id": { "type": "string", "minLength": 1 },
              "reserved_amount": { "type": "number", "minimum": 0 },
              "currency": { "type": "string", "enum": ["CNY"] },
              "reserved_at": { "type": "string", "format": "date" },
              "occupancy": {
                "enum": ["reserved", "disbursed", "released"],
                "description": "占用状态，防止同一企业/同一项目重复申领"
              }
            },
            "additionalProperties": false
          },
          "data_isolation": {
            "type": "object",
            "required": ["tenant_scope", "commercial_data_visible_to_provider", "separation_mechanism"],
            "properties": {
              "tenant_scope": { "type": "string", "minLength": 1 },
              "commercial_data_visible_to_provider": { "type": "boolean" },
              "separation_mechanism": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          },
          "evidence_ownership": {
            "type": "object",
            "required": ["enterprise_owns_evidence", "portable_on_switch", "export_format"],
            "properties": {
              "enterprise_owns_evidence": { "type": "boolean" },
              "portable_on_switch": { "type": "boolean" },
              "export_format": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          },
          "records": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["record_id", "kind", "at", "evidence_id"],
              "properties": {
                "record_id": { "type": "string", "minLength": 1 },
                "kind": {
                  "enum": [
                    "signing",
                    "deployment",
                    "metric_reading",
                    "stage_acceptance",
                    "usage_log",
                    "failure_exit",
                    "data_export",
                    "provider_data_deletion"
                  ]
                },
                "at": { "type": "string", "format": "date" },
                "evidence_id": { "type": "string", "minLength": 1 },
                "stage": { "type": "string" },
                "passed": { "type": "boolean" },
                "line_id": { "type": "string" },
                "metric_id": { "type": "string" },
                "value": { "type": "number" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
