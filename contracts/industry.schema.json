{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "行业与工序、指标目录",
  "type": "object",
  "required": ["domain", "version", "industries"],
  "properties": {
    "domain": { "const": "sme-digital-matching" },
    "version": { "type": "integer", "minimum": 1 },
    "industries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["industry_id", "name", "processes", "metrics"],
        "properties": {
          "industry_id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "processes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["process_id", "name"],
              "properties": {
                "process_id": { "type": "string", "minLength": 1 },
                "name": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          },
          "metrics": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["metric_id", "name", "unit", "direction"],
              "properties": {
                "metric_id": { "type": "string", "minLength": 1 },
                "name": { "type": "string", "minLength": 1 },
                "unit": { "type": "string", "minLength": 1 },
                "direction": { "enum": ["higher_better", "lower_better"] }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
