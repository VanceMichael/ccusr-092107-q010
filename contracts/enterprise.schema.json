{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "企业画像与产线基线",
  "type": "object",
  "required": ["domain", "doc_type", "version", "enterprise", "production_line", "targets", "constraints", "evidence_vault"],
  "properties": {
    "domain": { "const": "sme-digital-matching" },
    "doc_type": { "const": "enterprise_profile" },
    "version": { "type": "integer", "minimum": 1 },
    "sample_id": { "type": "string" },
    "enterprise": {
      "type": "object",
      "required": ["id", "name", "industry_id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "industry_id": { "type": "string" },
        "stage": { "type": "string" },
        "size": { "type": "object" }
      }
    },
    "production_line": {
      "type": "object",
      "required": ["id", "steps", "baseline"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "name"],
            "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "equipment": { "type": "array", "items": { "type": "string" } } }
          }
        },
        "baseline": {
          "type": "object",
          "required": ["measured_from", "measured_to", "metrics"],
          "properties": {
            "measured_from": { "type": "string" },
            "measured_to": { "type": "string" },
            "metrics": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["id", "metric", "value", "unit", "measured_at", "source", "evidence_refs"],
                "properties": {
                  "id": { "type": "string" },
                  "step_id": { "type": ["string", "null"] },
                  "metric": { "type": "string" },
                  "value": { "type": "number" },
                  "unit": { "type": "string" },
                  "measured_at": { "type": "string" },
                  "source": { "type": "string", "minLength": 1 },
                  "evidence_refs": { "type": "array", "minItems": 1, "items": { "type": "string" } }
                }
              }
            }
          }
        }
      }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "metric_id", "direction", "target_value", "unit"],
        "properties": {
          "id": { "type": "string" },
          "metric_id": { "type": "string", "description": "必须引用本企业实测基线指标，不得引用行业均值" },
          "direction": { "enum": ["increase", "decrease"] },
          "target_value": { "type": "number" },
          "unit": { "type": "string" },
          "deadline": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "constraints": {
      "type": "object",
      "required": ["shutdown_windows", "budget"],
      "properties": {
        "shutdown_windows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "recurrence", "max_continuous_hours"],
            "properties": {
              "id": { "type": "string" },
              "recurrence": { "type": "string" },
              "max_continuous_hours": { "type": "number" }
            }
          }
        },
        "blackout_periods": { "type": "array", "items": { "type": "object" } },
        "budget": {
          "type": "object",
          "required": ["first_year_cap_cny"],
          "properties": {
            "total_cap_cny": { "type": "number" },
            "first_year_cap_cny": { "type": "number" },
            "currency": { "type": "string" }
          }
        }
      }
    },
    "evidence_vault": {
      "type": "array",
      "description": "企业自有的基线证据仓，更换服务商不影响其归属",
      "items": {
        "type": "object",
        "required": ["id", "name", "captured_by", "retained_by_enterprise"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "captured_by": { "const": "enterprise" },
          "captured_at": { "type": "string" },
          "sha256": { "type": "string" },
          "retained_by_enterprise": { "const": true }
        }
      }
    }
  },
  "additionalProperties": false
}
