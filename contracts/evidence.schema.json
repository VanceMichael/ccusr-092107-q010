{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "证据登记册：基线测量、案例、合同、验收、读数、退出与导出凭证",
  "type": "object",
  "required": ["domain", "version", "evidence"],
  "properties": {
    "domain": { "const": "sme-digital-matching" },
    "version": { "type": "integer", "minimum": 1 },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["evidence_id", "kind", "owner", "verifier", "recorded_at", "summary"],
        "properties": {
          "evidence_id": { "type": "string", "minLength": 1 },
          "kind": {
            "enum": [
              "measured_reading",
              "third_party_report",
              "signed_document",
              "system_log_export",
              "case_reference",
              "deletion_confirmation",
              "export_manifest"
            ]
          },
          "owner": { "enum": ["enterprise", "provider"] },
          "verifier": {
            "enum": ["enterprise", "provider", "customer", "third_party", "joint"]
          },
          "recorded_at": { "type": "string", "format": "date" },
          "summary": { "type": "string", "minLength": 1 },
          "source_ref": { "type": "string" },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
